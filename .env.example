# SerpAPI — get from serpapi.com (free: 250 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Google Cloud API Key — enable "Maps Embed API" only
# get from console.cloud.google.com
GOOGLE_MAPS_EMBED_KEY=your_google_maps_embed_key_here

# Google Gemini — get from aistudio.google.com
# Use Gemini 1.5 Flash model (free: 1500 requests/day)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=3000

# Admin Authentication
ADMIN_USERNAME=admin@pagepilot.com
ADMIN_PASSWORD=Admin@PagePilot2026!
SESSION_SECRET=your_random_session_secret_key

# Domain & Web Server Provisioning
MAIN_DOMAIN=amolw.xyz
WEB_ROOT_BASE=/var/www
WEB_USER=www-data

# Cloudflare DNS API (optional: auto-creates A record for generated subdomains)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_DEFAULT_IP=your_server_ip_here

# Optional Nginx & SSL provisioning settings
# NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
# NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
# SSL_CERT_DIR=/etc/ssl/certs
# SSL_KEY_DIR=/etc/ssl/private
# NGINX_RELOAD_CMD=systemctl reload nginx
# SKIP_NGINX_PROVISION=false

